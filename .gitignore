# Environnements virtuels
.venv/
env/
venv/

# Caches Python et compilation
__pycache__/
*.py[cod]
*$py.class

# Donnees volumineuses (suivies par DVC)
data/raw/*.csv
data/processed/*.csv

# Modeles binaires lourds
models/*.pkl

# Caches de tests et de qualite
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
reports/*.html

# MLflow (backend SQLite et artifact store locaux)
mlflow.db
mlruns/

# Modeles et rapports generes
models/*.joblib
reports/plots/
reports/*.png
reports/demo_*.csv
cml_report/

# Reentrainement (fichiers de travail generes par le flow de drift)
data/retrain/

# Secrets et configuration locale
.env
.dvc/config.local
*.pem

# Bundles de modeles copies pour le Blue/Green
deploy/models/*/*
!deploy/models/*/.gitkeep
